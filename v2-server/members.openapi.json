{
  "openapi": "3.0.3",
  "info": {
    "title": "Temporary v2 members",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v2/tenants/{tid}/members": {
      "post": {
        "operationId": "inviteMember",
        "tags": [
          "members"
        ],
        "parameters": [
          {
            "name": "tid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteMemberInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitedMember"
                }
              }
            }
          },
          "400": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberError"
                }
              }
            }
          },
          "401": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberError"
                }
              }
            }
          },
          "403": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberError"
                }
              }
            }
          },
          "404": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberError"
                }
              }
            }
          },
          "409": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberError"
                }
              }
            }
          },
          "500": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "InviteMemberInput": {
        "type": "object",
        "required": [
          "email"
        ],
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "squadId": {
            "type": "string"
          }
        }
      },
      "InvitedMember": {
        "type": "object",
        "required": [
          "id",
          "tenantId",
          "userId",
          "displayName",
          "role",
          "status",
          "version"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "member"
            ]
          },
          "status": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "format": "int64"
          },
          "actorDisplayName": {
            "type": "string",
            "nullable": true
          },
          "joinMethod": {
            "type": "string",
            "nullable": true
          },
          "joinedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "MemberError": {
        "type": "object",
        "required": [
          "code",
          "params",
          "requestId"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          },
          "requestId": {
            "type": "string"
          }
        }
      }
    }
  }
}
